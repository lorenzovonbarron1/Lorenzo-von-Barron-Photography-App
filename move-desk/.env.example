# ── LYNK Move Desk — environment ────────────────────────────
# Everything is OPTIONAL. With nothing set, the app runs fully in
# MOCK mode: leads are validated, an Auto-Brief is built, and
# delivery is logged (not sent). Set a group to make it live.

# Lead email (Resend) — agent + lead confirmations
RESEND_API_KEY=
LEAD_EMAIL_FROM=movedesk@your-verified-domain.com

# Lead SMS (Twilio) — OFF unless SMS_ENABLED=true is ALSO set.
# Credentials alone never enable texting (TCPA). Before enabling:
# consent copy reviewed, STOP handling configured, A2P 10DLC done.
SMS_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# Source of truth (CRM / Airtable / Zapier catch-hook)
CRM_WEBHOOK_URL=

# Real calendar (Cal.com / Calendly) — makes "request a time" a booking
NEXT_PUBLIC_CAL_BOOKING_URL=

# Where agent lead alerts go (overrides lib/agent.config.ts values)
AGENT_NOTIFY_EMAIL=
AGENT_NOTIFY_PHONE=

# NOTE: the active agent's own public phone/email live in
# lib/agent.config.ts, not here — they are identity, not secrets.
# Full contract per variable: docs/INTEGRATIONS.md
